global.__bigname_surface_cache = {}

/// @function draw_text_bigname
/// @param x
/// @param y
/// @param text
/// @param color=-1
/// @param alpha=-1
/// @param scale=0.65
/// @param angle=0
// ===================================================================================
// 全语言统一直绘版—— 渲染收敛点：所有语言的大字都从这里直绘
// 继承：6-1 余量 / 6-G 宽度宽松化 / 6-H 高度公式 / 6-K 横向余量分配 / 6-I 纵向锚（CJK）/
//       6-M2 测量封顶（在 font_string_measure 层，不在此文件）/ 6-N/O 阴影结构
// 拆除：6-P/S/U/Q 全部残留、原管线分支（无兜底）
// ===================================================================================
function draw_text_bigname(_x, _y, _text, _color = draw_get_color(), _alpha = draw_get_alpha(), _scale = 0.65, _angle = 0) {
	_text = string_upper(string_hash_to_newline(_text))

	// surface 上下安全余量：防 CJK 字形底部被裁（继承 6-1）
	var _pad = 12

	// 修复「安卓切后台后主菜单按钮靠右」（6-K 起潜伏）：
	// surface 内容（_cx）与 halign 相关；切后台丢 surface 后若由其他 halign 上下文
	// （暂停菜单 fa_right 绘制 SETTINGS/QUIT）重建缓存，主菜单（fa_center）会复用
	// 贴右内容 → 靠右。修复 = halign 计入缓存键（各上下文各自成键）。
	var _src = scrBignameSourceGet(), // 全语言直绘源（cjk / en / cyr）
		_halign = draw_get_halign(),
		_valign = draw_get_valign(),
		_key = variable_get_hash($"{_src.kind}[{_scale}][{_halign}]|{_text}"),
		_surface = struct_get_from_hash(global.__bigname_surface_cache, _key)

	if !(is_numeric(_surface) && surface_exists(_surface)) {
		var _last_font = draw_get_font(),
			_last_alpha = draw_get_alpha()

		draw_set_font(global.language_font_bigname_default) // 仅用于测量（语义与旧版一致）
		draw_set_halign(fa_left)
		draw_set_valign(fa_top)
		draw_set_alpha(1)

		// 尺寸：继承 6-G/6-H/6-K 全部既有语义
		var _cw = ceil(max(font_get_string_width(_text), string_width(_text)) * _scale),
			_h = ceil(font_get_string_height(_text) * _scale),
			_w = _cw + ceil(_cw * 0.8) + 8,
			_cx = 4

		if (_halign == fa_center) _cx = ceil((_w - _cw) / 2)
		else if (_halign == fa_right) _cx = _w - _cw

		var _offset = font_get_height_diff() - 6,
			_info = font_get_info(global.language_font_bigname_default)

		if (sprite_exists(_info.spriteIndex)) {
			_offset -= sprite_get_yoffset(_info.spriteIndex) - 7
		}

		var _hh = max(_h + _pad * 2, (_pad - _offset) + ceil(44 * _scale) + 8)

		_surface = surface_create(_w, _hh)

		surface_set_target(_surface)
		draw_clear_alpha(c_black, 0)

		// 纵向锚（源专属）：
		//   CJK = 6-I 定稿公式（x2: _pad - _offset - 19×scale）
		//   EN/CYR = 基准转储实测（q=1 → 11.0；q=0.65 → 13.4；线性 11 + 6.857×(1−scale)）
		var _top = (_src.kind == "cjk") ? round((_pad - _offset) - 19 * _scale) : round(11 + 6.857 * (1 - _scale))

		// 阴影结构（逐层对齐旧版）：基础 3 黑 + 1 白；_scale>=1 追加外层黑 +2（6-O 语义）
		scrBignameDrawGlyphs(_src, _cx + 1, _top, _text, _scale, c_black)
		scrBignameDrawGlyphs(_src, _cx, _top + 1, _text, _scale, c_black)
		scrBignameDrawGlyphs(_src, _cx + 1, _top + 1, _text, _scale, c_black)
		if (_scale >= 1) {
			scrBignameDrawGlyphs(_src, _cx, _top + 2, _text, _scale, c_black)
			scrBignameDrawGlyphs(_src, _cx + 1, _top + 2, _text, _scale, c_black)
		}
		scrBignameDrawGlyphs(_src, _cx, _top, _text, _scale, c_white)

		surface_reset_target()

		draw_set_font(_last_font)
		draw_set_halign(_halign)
		draw_set_valign(_valign)
		draw_set_alpha(_last_alpha)

		if (GM_build_type == "run") surface_save(_surface, "bigname/" + _text + ".png")

		struct_set_from_hash(global.__bigname_surface_cache, _key, _surface)
	}

	/**/ if (_halign == fa_center) _x -= surface_get_width(_surface) / 2
	else if (_halign == fa_right) _x -= surface_get_width(_surface)

	// 纵向对齐取「逻辑高度」（6-H 语义）；CJK 补正 +3×scale（6-I 语义）
	var _f = draw_get_font()
	draw_set_font(global.language_font_bigname_default)
	var _h_log = ceil(font_get_string_height(_text) * _scale)

	var _xadd = (_src.kind == "cjk") ? round(3 * _scale) : 0
	/**/ if (_valign == fa_middle) _y -= _h_log / 2 + _xadd
	else if (_valign == fa_bottom) _y -= _h_log + _xadd * 2

	// 上屏取整 half-up（消灭半像素跳变；round half-even → floor(v+0.5)）
	draw_surface_ext(_surface, round(_x), floor(_y - font_get_height_diff() - 6 + 0.5) - _pad, 1, 1, _angle, _color, _alpha)
	draw_set_font(_f)
}

function scrBignameSurfaceCleanup() {
	struct_foreach(global.__bigname_surface_cache, function(_key, _surface) {
		if surface_exists(_surface) {
			surface_free(_surface)
		}
	})
}

// ===================================================================================
// bigname 字形直绘（全语言统一）—— 表 + 直绘 + 源选择
