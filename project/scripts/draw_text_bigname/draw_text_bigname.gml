/// 快速解析（string_split，替代逐字符循环）
function scrBignameParseTable(_raw) {
	var _t = {}, _rows = string_split(_raw, ";")
	for (var _i = 0; _i < array_length(_rows); ++_i) {
		var _v = string_split(_rows[_i], ",")
		if (array_length(_v) == 8) {
			_t[$ chr(real(_v[0]))] = {
				frame: real(_v[1]), sx: real(_v[2]), sy: real(_v[3]),
				sw: real(_v[4]), sh: real(_v[5]), shift: real(_v[6]), offset: real(_v[7]),
			}
		}
	}
	return _t
}

/// 源选择（按当前语言的大名字体）
function scrBignameSourceGet() {
	var _f = global.language_font_bigname_default
	if (_f == fntCJKBig) {
		return { kind: "cjk", spr: sprBignameAtlas, line: 57, ox: 0 }
	}
	if (_f == global.language_font_bigname_cyrillic) {
		return { kind: "cyr", spr: global.language_font_bigname_cyrillic_spr, line: 40, ox: -7 }
	}
	return { kind: "en", spr: sprBigNameFont, line: 40, ox: -5 }
}

/// 字形直绘（统一；换行 = 源槽高 ×_F）
function scrBignameDrawGlyphs(_src, _x, _y, _text, _F, _col) {
	var _tbl = scrBignameTableGet(_src.kind),
		_n = string_length(_text),
		_pen = _x
	for (var _i = 1; _i <= _n; ++_i) {
		var _c = string_char_at(_text, _i)
		if (_c == "\n") { _pen = _x; _y += _src.line * _F; continue }
		var _g = _tbl[$ _c]
		if (!is_struct(_g)) continue
		if (_g.frame >= 0) draw_sprite_part_ext(_src.spr, _g.frame, _g.sx, _g.sy, _g.sw, _g.sh, _pen + (_g.offset + _src.ox) * _F, _y, _F, _F, _col, 1)
		_pen += _g.shift * _F
	}
}
