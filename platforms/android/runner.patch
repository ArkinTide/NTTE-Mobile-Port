+    protected static GamepadHandler ms_GamepadHandler;
+    private static final int MAX_PENDING = 256;
+    private static final ArrayDeque<PendingInput> pending = new ArrayDeque<PendingInput>();
+    private static final HashSet<Integer> refreshIds = new HashSet<Integer>();
+    private static final HashMap<Integer, Long> readyAfter = new HashMap<Integer, Long>();
+    private static boolean scanRequested = true;
+    private static boolean resetAll = false;
+    private static boolean paused = false;
+    private static long frame = 0;
+    private static InputManager inputManager;
+
+    private static class PendingInput {
+        int deviceId;
+        KeyEvent key;
+        MotionEvent motion;
+        PendingInput(KeyEvent event) {
+            deviceId = event.getDeviceId();
+            key = new KeyEvent(event);
+        }
+        PendingInput(MotionEvent event) {
+            deviceId = event.getDeviceId();
+            motion = MotionEvent.obtain(event);
+        }
+        void recycle() { if (motion != null) motion.recycle(); }
+    }
+
+    private static final InputManager.InputDeviceListener deviceListener = new InputManager.InputDeviceListener() {
+        public void onInputDeviceAdded(int id) { RequestScan(); }
+        public void onInputDeviceRemoved(int id) { DeviceChanged(id); }
+        public void onInputDeviceChanged(int id) { DeviceChanged(id); }
+    };
+
+    public static boolean IsControllerSource(int source) {
+        return ((source & InputDevice.SOURCE_JOYSTICK) == InputDevice.SOURCE_JOYSTICK)
+            || ((source & InputDevice.SOURCE_GAMEPAD) == InputDevice.SOURCE_GAMEPAD)
+            || ((source & InputDevice.SOURCE_DPAD) == InputDevice.SOURCE_DPAD);
+    }
+
+    public static synchronized void Initialise() {
+        // Activity callbacks never enumerate or mutate native gamepad lists.
+        if (ms_GamepadHandler == null) {
+            ms_GamepadHandler = Build.VERSION.SDK_INT >= 19 ? new GamepadHandler_API19() : new GamepadHandler_API16();
+        }
+        scanRequested = true;
+    }
+
+    public static synchronized void Start(Context context) {
+        Initialise();
+        if (inputManager == null) {
+            inputManager = (InputManager)context.getSystemService(Context.INPUT_SERVICE);
+            if (inputManager != null) inputManager.registerInputDeviceListener(deviceListener, new Handler(Looper.getMainLooper()));
+        }
+        scanRequested = true;
+    }
+
+    public static synchronized void Resume(Context context) {
+        Start(context);
+        paused = false;
+        scanRequested = true;
+    }
+
+    public static synchronized void Pause() {
+        paused = true;
+        ClearPending();
+        resetAll = true; // Neutralize keys/axes even when their release happens in background.
+        scanRequested = true;
+    }
+
+    public static synchronized void Stop() {
+        Pause();
+        if (inputManager != null) inputManager.unregisterInputDeviceListener(deviceListener);
+        inputManager = null;
+    }
+
+    public static synchronized void OnRunnerRestart() {
+        ClearPending();
+        ms_GamepadHandler = null;
+        refreshIds.clear();
+        readyAfter.clear();
+        resetAll = false;
+        scanRequested = true;
+    }
+
+    private static void ClearPending() {
+        while (!pending.isEmpty()) pending.removeFirst().recycle();
+    }
+
+    private static synchronized void DeviceChanged(int id) {
+        refreshIds.add(id); // Keep remove+add invalidation even if the final ID list is unchanged.
+        scanRequested = true;
+        Iterator<PendingInput> it = pending.iterator();
+        while (it.hasNext()) {
+            PendingInput input = it.next();
+            if (input.deviceId == id) { input.recycle(); it.remove(); }
+        }
+    }
+
+    private static synchronized void RequestScan() {
+        // Added may be delivered after the first input. Preserve that first press.
+        scanRequested = true;
+    }
+
+    private static void Enqueue(PendingInput input) {
+        if (pending.size() >= MAX_PENDING) {
+            ClearPending();
+            resetAll = true;
+            scanRequested = true;
+        }
+        pending.addLast(input);
+    }
+
+    public static synchronized boolean handleKeyEvent(KeyEvent event) {
+        InputDevice device = InputDevice.getDevice(event.getDeviceId());
+        int code = event.getKeyCode();
+        boolean key = KeyEvent.isGamepadButton(code) || (code >= KeyEvent.KEYCODE_DPAD_UP && code <= KeyEvent.KEYCODE_DPAD_CENTER) || code == KeyEvent.KEYCODE_BACK;
+        if (device == null || event.getDeviceId() < 0 || !IsControllerSource(device.getSources()) || !key) return false;
+        if (!paused && (event.getAction() == KeyEvent.ACTION_DOWN || event.getAction() == KeyEvent.ACTION_UP)) {
+            if (event.getAction() != KeyEvent.ACTION_DOWN || event.getRepeatCount() == 0) Enqueue(new PendingInput(event));
+        }
+        return true;
+    }
+
+    public static synchronized boolean handleMotionEvent(MotionEvent event) {
+        if (!IsControllerSource(event.getSource()) || event.getDeviceId() < 0 || event.getActionMasked() != MotionEvent.ACTION_MOVE) return false;
+        if (!paused) {
+            PendingInput last = pending.peekLast();
+            if (last != null && last.motion != null && last.deviceId == event.getDeviceId()) pending.removeLast().recycle();
+            Enqueue(new PendingInput(event));
+        }
+        return true;
+    }
+
+    /** Called by native code on its runner thread; never from the UI listener. */
+    public static synchronized void EnumerateDevices() {
+        if (ms_GamepadHandler == null) Initialise();
+        ms_GamepadHandler.PollInputDevices();
+    }
+
+    /** Run immediately before each native Process, after native Startup. */
+    public static synchronized void ProcessInput() {
+        if (paused) return;
+        ++frame;
+        if (ms_GamepadHandler == null) Initialise();
+        GamepadHandler_API12 handler = (GamepadHandler_API12)ms_GamepadHandler;
+        if (resetAll) refreshIds.addAll(handler.DeviceIds());
+        resetAll = false;
+        for (Integer id : refreshIds) {
+            if (handler.RemoveDevice(id)) readyAfter.put(id, frame + 1);
+        }
+        refreshIds.clear();
+        if (scanRequested) { handler.PollInputDevices(); scanRequested = false; }
+
+        if (pending.isEmpty()) return;
+        HashSet<String> transitions = new HashSet<String>();
+        while (!pending.isEmpty()) {
+            PendingInput input = pending.peekFirst();
+            Long ready = readyAfter.get(input.deviceId);
+            if (ready != null && frame < ready) break;
+            readyAfter.remove(input.deviceId);
+            if (handler.GetGamepad(input.deviceId) == null) handler.PollInputDevices();
+            if (handler.GetGamepad(input.deviceId) == null) {
+                pending.removeFirst().recycle();
+                continue;
+            }
+            if (input.key != null) {
+                String button = input.deviceId + ":" + input.key.getKeyCode();
+                // JNI stores only current state. Preserve a Process between down/up.
+                if (transitions.contains(button)) break;
+                transitions.add(button);
+                handler.HandleKeyEvent(input.deviceId, input.key);
+            } else {
+                handler.HandleMotionEvent(input.motion);
+            }
+            pending.removeFirst().recycle();
+        }
+    }
