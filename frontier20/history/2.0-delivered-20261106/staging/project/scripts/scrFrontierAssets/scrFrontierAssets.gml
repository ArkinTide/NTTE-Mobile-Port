function scrFRAssetAtSource(_source,_line) {
    var _key=_source+":"+string(_line);
    assert(variable_struct_exists(global.fr_asset_sources,_key),"Unknown Frontier declared asset "+_key);
    return global.fr_asset_sources[$ _key];
}
